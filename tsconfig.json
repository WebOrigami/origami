{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "lib": ["ES2024", "DOM"],
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "module": "NodeNext",
    "skipLibCheck": true,
    "target": "ES2024"
  },
  "include": ["**/*.js"],
  "exclude": ["origami/src/dev/explore.inline.js"]
}
